    97                              <1> %define WM_TIMER             0x0113
    98                              <1> %define WM_LBUTTONDOWN       0x0201
    99                              <1> 
   100                              <1> %define VK_ESCAPE            0x1B
   101                              <1> %define VK_SPACE             0x20
   102                              <1> %define PM_REMOVE            0x0001
   103                              <1> 
   104                              <1> %define TRANSPARENT          1
