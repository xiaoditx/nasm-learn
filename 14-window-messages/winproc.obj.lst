   233 00000008 ????????            <1>     .pixelSize_width:  resd 1    ; +8
   234 0000000C ????????            <1>     .pixelSize_height: resd 1    ; +12
   235 00000010 ????????            <1>     .presentOptions: resd 1      ; +16
   236 00000014 ????????            <1>     .pad:            resd 1      ; +20  尾部填充
   237                              <1> endstruc                          ; = 24
