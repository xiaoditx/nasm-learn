    50 00000096 640020007800200025- <1>
    50 0000009F 0064000000          <1>
    35                                  
    36                                  section .bss
    37 00000000 <res 50h>               wndclass:  resb WNDCLASSEXW_size
    38 00000050 <res 30h>               msg:       resb MSG_size
    39 00000080 <res 48h>               ps:        resb PAINTSTRUCT_size
    40 000000C8 ????????????????        hwnd:      resq 1
    41 000000D0 <res 80h>               title_buf: resb 128                 ; SetWindowTextW 用的缓冲区
    42 00000150 ????????                g_width:   resd 1
