    30                                  section .data
    31                                  class_name:   WSTRZ "MasmLearnWinProc"
    31                              <1> class_name: 
    50 00000000 4D00610073006D004C- <1>  dw __utf16__(%1), 0
    50 00000009 006500610072006E00- <1>
    50 00000012 570069006E00500072- <1>
    50 0000001B 006F0063000000      <1>
    32                                  window_title: WSTRZ "x64 assembly - window procedure"
    32                              <1> window_title: 
    50 00000022 780036003400200061- <1>  dw __utf16__(%1), 0
    50 0000002B 007300730065006D00- <1>
    50 00000034 62006C00790020002D- <1>
    50 0000003D 002000770069006E00- <1>
    50 00000046 64006F007700200070- <1>
    50 0000004F 0072006F0063006500- <1>
    50 00000058 640075007200650000- <1>
    50 00000061 00                  <1>
    33                                  fmt_key:      WSTRZ "last key: 0x%04X"
    33                              <1> fmt_key: 
    50 00000062 6C0061007300740020- <1>  dw __utf16__(%1), 0
    50 0000006B 006B00650079003A00- <1>
    50 00000074 200030007800250030- <1>
    50 0000007D 00340058000000      <1>
    34                                  fmt_size:     WSTRZ "client: %d x %d"
    34                              <1> fmt_size: 
    50 00000084 63006C00690065006E- <1>  dw __utf16__(%1), 0
