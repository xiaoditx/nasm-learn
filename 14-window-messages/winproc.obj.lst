    84                              <1> %define IDI_APPLICATION      32512
    85                              <1> %define COLOR_WINDOW         5
    86                              <1> %define COLOR_WINDOWTEXT     8
    87                              <1> 
    88                              <1> %define WM_CREATE            0x0001
    89                              <1> %define WM_DESTROY           0x0002
