    46                                  section .text
    47                                  
    48                                  ; ------------------------------------------------------------
    49                                  ; WndProc(HWND rcx, UINT edx, WPARAM r8, LPARAM r9) -> LRESULT rax
    50                                  ;
    51                                  ; ABI 四件套在这里全部出现：
    52                                  ;   1) 参数 RCX/RDX/R8/R9
    53                                  ;   2) 32 字节影子空间
    54                                  ;   3) 入口 8、call 点 0 的 16 字节对齐
    55                                  ;   4) 非易失寄存器（本章改用全局变量，不占用 RBX/RDI/RSI）
    56                                  ; ------------------------------------------------------------
    57                                  WndProc:
    58 00000000 55                          push    rbp
    59 00000001 4889E5                      mov     rbp, rsp
    60 00000004 4883EC20                    sub     rsp, FRAME_SUB_RSP      ; 32 字节影子空间
    61                                  
    62 00000008 83FA01                      cmp     edx, WM_CREATE
    63 0000000B 7438                        je      .on_create
    64 0000000D 83FA05                      cmp     edx, WM_SIZE
    65 00000010 7437                        je      .on_size
    66 00000012 81FA00010000                cmp     edx, WM_KEYDOWN
    67 00000018 744B                        je      .on_keydown
    68 0000001A 83FA10                      cmp     edx, WM_CLOSE
    69 0000001D 0F848D000000                je      .on_close
    70 00000023 83FA02                      cmp     edx, WM_DESTROY
    71 00000026 0F8494000000                je      .on_destroy
    72 0000002C 83FA0F                      cmp     edx, WM_PAINT
    73 0000002F 0F8496000000                je      .on_paint
    74 00000035 83FA14                      cmp     edx, WM_ERASEBKGND
    75 00000038 0F84B7000000                je      .on_erase
    76                                  
    77 0000003E E8(00000000)                call    DefWindowProcW
    78 00000043 C9                          leave
    79 00000044 C3                          ret
    80                                  
    81                                  ; ---- WM_CREATE：lParam 是 CREATESTRUCT*，本例只做计数 ----
    82                                  .on_create:
    83 00000045 31C0                        xor     eax, eax
    84 00000047 C9                          leave
    85 00000048 C3                          ret
    86                                  
    87                                  ; ---- WM_SIZE：lParam 低 16 位 = 宽，高 16 位 = 高 ----
    88                                  .on_size:
    89 00000049 4489C8                      mov     eax, r9d
    90 0000004C 0FB7C8                      movzx   ecx, ax                 ; LOWORD(lParam)
    91 0000004F 890D(50010000)              mov     [rel g_width], ecx
    92 00000055 C1E810                      shr     eax, 16
    93 00000058 0FB7C8                      movzx   ecx, ax                 ; HIWORD(lParam)
    94 0000005B 890D(54010000)              mov     [rel g_height], ecx
    95 00000061 31C0                        xor     eax, eax
    96 00000063 C9                          leave
    97 00000064 C3                          ret
    98                                  
    99                                  ; ---- WM_KEYDOWN：wParam 是虚拟键码 ----
   100                                  .on_keydown:
   101 00000065 4183F81B                    cmp     r8d, VK_ESCAPE
   102 00000069 7435                        je      .escape
   103                                  
   104 0000006B FF05(58010000)              inc     dword [rel g_keys]
   105                                  
   106                                      ; wsprintfW(buf, "last key: 0x%04X", wParam)：变参函数，AL 必须为 0
   107 00000071 488D0D(D0000000)            lea     rcx, [rel title_buf]
   108 00000078 488D15(62000000)            lea     rdx, [rel fmt_key]
   109 0000007F 4589C0                      mov     r8d, r8d                ; wParam 已在 R8，这里只是强调来源
   110 00000082 31C0                        xor     eax, eax
   111 00000084 E8(00000000)                call    wsprintfW
   112                                  
   113                                      ; SetWindowTextW(hwnd, buf)
   114 00000089 488B0D(C8000000)            mov     rcx, [rel hwnd]
   115 00000090 488D15(D0000000)            lea     rdx, [rel title_buf]
   116 00000097 E8(00000000)                call    SetWindowTextW
   117                                  
   118 0000009C 31C0                        xor     eax, eax
   119 0000009E C9                          leave
   120 0000009F C3                          ret
   121                                  
   122                                  .escape:
   123                                      ; 直接销毁窗口：系统随后发送 WM_DESTROY
   124 000000A0 488B0D(C8000000)            mov     rcx, [rel hwnd]
   125 000000A7 E8(00000000)                call    DestroyWindow
   126 000000AC 31C0                        xor     eax, eax
   127 000000AE C9                          leave
   128 000000AF C3                          ret
   129                                  
   130                                  ; ---- WM_CLOSE：默认处理就是 DestroyWindow，这里显式写出来 ----
   131                                  .on_close:
   132 000000B0 488B0D(C8000000)            mov     rcx, [rel hwnd]
   133 000000B7 E8(00000000)                call    DestroyWindow
   134 000000BC 31C0                        xor     eax, eax
   135 000000BE C9                          leave
   136 000000BF C3                          ret
   137                                  
   138                                  ; ---- WM_DESTROY：投递 WM_QUIT，让 GetMessageW 返回 0 ----
   139                                  .on_destroy:
   140 000000C0 31C9                        xor     ecx, ecx
   141 000000C2 E8(00000000)                call    PostQuitMessage
   142 000000C7 31C0                        xor     eax, eax
   143 000000C9 C9                          leave
   144 000000CA C3                          ret
   145                                  
   146                                  ; ---- WM_PAINT：本章只做 BeginPaint/EndPaint，把窗口标记为有效 ----
   147                                  .on_paint:
   148 000000CB 488B0D(C8000000)            mov     rcx, [rel hwnd]
   149 000000D2 488D15(80000000)            lea     rdx, [rel ps]
   150 000000D9 E8(00000000)                call    BeginPaint             ; 返回 HDC，本章不用
   151                                  
   152 000000DE 488B0D(C8000000)            mov     rcx, [rel hwnd]
   153 000000E5 488D15(80000000)            lea     rdx, [rel ps]
   154 000000EC E8(00000000)                call    EndPaint
   155                                  
   156 000000F1 31C0                        xor     eax, eax
   157 000000F3 C9                          leave
   158 000000F4 C3                          ret
   159                                  
   160                                  ; ---- WM_ERASEBKGND：返回 1 表示“背景我自己擦”，减少闪烁 ----
   161                                  .on_erase:
   162 000000F5 B801000000                  mov     eax, 1
   163 000000FA C9                          leave
   164 000000FB C3                          ret
