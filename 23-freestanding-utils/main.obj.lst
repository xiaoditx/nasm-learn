    61 00000042 488D0D(66000000)            lea     rcx, [rel str_lbl_max]
    62 00000049 E8(00000000)                call    util_print_wstr
    63 0000004E 48C7C1FFFFFFFF              mov     rcx, -1                     ; 0xFFFFFFFFFFFFFFFF
    64 00000055 488D15(00000000)            lea     rdx, [rel numbuf]
    65 0000005C E8(00000000)                call    util_u64_to_wstr
