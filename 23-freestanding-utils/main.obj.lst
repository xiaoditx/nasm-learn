    38                                  ; ------------------------------------------------------------
    39                                  ; _start：RSP%16==8 → sub rsp,40 后 ==0
    40                                  ; 只调用本模块外的 util_* 与 ExitProcess，最大栈参 0 → 40 字节帧足够
    41                                  ; ------------------------------------------------------------
    42                                  _start:
    43 00000000 4883EC28                    sub     rsp, 40
    44                                  
    45                                      ; ---- 1. 直接打印字符串 ----
    46 00000004 488D0D(00000000)            lea     rcx, [rel str_hello]
    47 0000000B E8(00000000)                call    util_print_wstr
    48                                  
    49                                      ; ---- 2. u64 = 0（验证 do-while 能生成 '0'） ----
    50 00000010 488D0D(46000000)            lea     rcx, [rel str_lbl_zero]
    51 00000017 E8(00000000)                call    util_print_wstr
    52 0000001C 31C9                        xor     ecx, ecx
    53 0000001E 488D15(00000000)            lea     rdx, [rel numbuf]
    54 00000025 E8(00000000)                call    util_u64_to_wstr
    55 0000002A 488D0D(00000000)            lea     rcx, [rel numbuf]
    56 00000031 E8(00000000)                call    util_print_wstr
    57 00000036 488D0D(DC000000)            lea     rcx, [rel str_crlf]
    58 0000003D E8(00000000)                call    util_print_wstr
    59                                  
