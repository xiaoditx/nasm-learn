    28                                  %define UTF8_BUF_SIZE  4096     ; 管道路径的 UTF-8 转换缓冲（演示程序够用了）
    29                                  
    30                                  section .bss
    31 00000000 ????????????????        h_out:        resq 1          ; 缓存的 stdout 句柄
    32 00000008 ????????                out_kind:     resd 1          ; 0=未检测  1=真控制台  2=管道/文件
    33 0000000C ????????                console_mode: resd 1          ; GetConsoleMode 的输出参数
    34 00000010 ????????                written:      resd 1          ; WriteConsoleW/WriteFile 的写出计数
    35 00000014 <res 1000h>             utf8_buf:     resb UTF8_BUF_SIZE
    36                                  
    37                                  section .text
    38                                  
    39                                  ; ------------------------------------------------------------
    40                                  ; util_wcslen(PCWSTR rcx) -> rax = 长度（码元数，不含结尾 0）
    41                                  ; 纯计算叶子函数：不调 API，不需要栈帧
    42                                  ; ------------------------------------------------------------
    43                                  util_wcslen:
    44 00000000 31C0                        xor     eax, eax
    45                                  .loop:
    46 00000002 66833C4100                  cmp     word [rcx + rax*2], 0
    47 00000007 7405                        je      .done
    48 00000009 48FFC0                      inc     rax
    49 0000000C EBF4                        jmp     .loop
    50                                  .done:
    51 0000000E C3                          ret
    52                                  
    53                                  ; ------------------------------------------------------------
    54                                  ; util_u64_to_wstr(u64 rcx, PWSTR rdx) -> rax = 写入长度（不含结尾 0）
    55                                  ; 十进制。div 得到的余数是"个位在前"，先正序存栈上临时缓冲，
    56                                  ; 再倒序拷回调用方缓冲。调用方保证缓冲 >= 21 个码元（20 位 + NUL）。
    57                                  ; 本函数不调 API，栈帧只是临时缓冲，对齐无要求（仍保持 16 倍数）。
    58                                  ; ------------------------------------------------------------
    59                                  util_u64_to_wstr:
    60 0000000F 55                          push    rbp
    61 00000010 4889E5                      mov     rbp, rsp
    62 00000013 4883EC30                    sub     rsp, 48                 ; [rbp-40 .. rbp-1] = 20 个码元的临时缓冲
    63                                  
    64 00000017 4989C8                      mov     r8, rcx                 ; r8 = 待转换值
    65 0000001A 4989D1                      mov     r9, rdx                 ; r9 = 目标缓冲
    66 0000001D 41BA0A000000                mov     r10d, 10                ; 除数
    67 00000023 31C9                        xor     ecx, ecx                ; 已生成位数
    68                                  
    69                                  .gen:                               ; do-while：保证 0 也能生成 '0'
    70 00000025 4C89C0                      mov     rax, r8
    71 00000028 31D2                        xor     edx, edx                ; div 用 RDX:RAX 被除数，高 64 位清零
    72 0000002A 49F7F2                      div     r10                     ; rax = 商，rdx = 余数（当前最低位）
    73 0000002D 83C230                      add     edx, '0'
    74 00000030 6689544DD8                  mov     [rbp + rcx*2 - 40], dx  ; temp[count] = 数字字符（低位在前）
    75 00000035 48FFC1                      inc     rcx
    76 00000038 4989C0                      mov     r8, rax
    77 0000003B 4D85C0                      test    r8, r8
    78 0000003E 75E5                        jnz     .gen
    79                                  
    80                                      ; 倒序拷贝：dest[i] = temp[count-1-i]
    81 00000040 31C0                        xor     eax, eax
    82                                  .copy:
    83 00000042 4889CE                      mov     rsi, rcx
    84 00000045 48FFCE                      dec     rsi
    85 00000048 4829C6                      sub     rsi, rax                ; rsi = count-1-i
    86 0000004B 668B5475D8                  mov     dx, [rbp + rsi*2 - 40]
    87 00000050 6641891441                  mov     [r9 + rax*2], dx
    88 00000055 48FFC0                      inc     rax
    89 00000058 4839C8                      cmp     rax, rcx
    90 0000005B 72E5                        jb      .copy
    91                                  
    92 0000005D 6641C704490000              mov     word [r9 + rcx*2], 0    ; NUL 结尾
    93 00000064 4889C8                      mov     rax, rcx                ; 返回长度
    94 00000067 C9                          leave
    95 00000068 C3                          ret
    96                                  
    97                                  ; ------------------------------------------------------------
    98                                  ; detect_out：填写 h_out / out_kind（惰性，只检测一次）
    99                                  ; GetConsoleMode 成功 → 真控制台；失败 → stdout 被重定向到管道/文件
   100                                  ; ------------------------------------------------------------
   101                                  detect_out:
   102 00000069 55                          push    rbp
   103 0000006A 4889E5                      mov     rbp, rsp
   104 0000006D 4883EC20                    sub     rsp, FRAME_SUB_RSP
   105                                  
   106 00000071 833D(08000000)00            cmp     dword [rel out_kind], 0
   107 00000078 753A                        jne     .done
   108                                  
   109 0000007A B9F5FFFFFF                  mov     ecx, STD_OUTPUT_HANDLE
   110 0000007F E8(00000000)                call    GetStdHandle
   111 00000084 488905(00000000)            mov     [rel h_out], rax
   112                                  
   113 0000008B 4889C1                      mov     rcx, rax
   114 0000008E 488D15(0C000000)            lea     rdx, [rel console_mode]
   115 00000095 E8(00000000)                call    GetConsoleMode
   116 0000009A 85C0                        test    eax, eax
   117 0000009C 740C                        jz      .pipe
   118 0000009E C705(08000000)0100-         mov     dword [rel out_kind], 1
   118 000000A6 0000               
   119 000000A8 EB0A                        jmp     .done
   120                                  .pipe:
   121 000000AA C705(08000000)0200-         mov     dword [rel out_kind], 2
   121 000000B2 0000               
   122                                  .done:
   123 000000B4 C9                          leave
   124 000000B5 C3                          ret
   125                                  
   126                                  ; ------------------------------------------------------------
   127                                  ; util_print_wstr(PCWSTR rcx)：打印一行（不带换行）
   128                                  ; 真控制台 → WriteConsoleW（UTF-16 直出）
   129                                  ; 管道/文件 → WideCharToMultiByte(CP_UTF8) + WriteFile
   130                                  ; 栈帧 80 = 32 影子 + 32 最大栈参（WideCharToMultiByte 后 4 参）+ 16 本地
   131                                  ; ------------------------------------------------------------
   132                                  util_print_wstr:
   133 000000B6 55                          push    rbp
   134 000000B7 4889E5                      mov     rbp, rsp
   135 000000BA 4883EC50                    sub     rsp, 80
   136 000000BE 48894DF8                    mov     [rbp - 8], rcx          ; 保存字符串指针
   137                                  
   138 000000C2 E839FFFFFF                  call    util_wcslen             ; rcx 已是参数
   139 000000C7 488945F0                    mov     [rbp - 16], rax         ; 保存长度
   140                                  
   141 000000CB E899FFFFFF                  call    detect_out
   142 000000D0 833D(08000000)01            cmp     dword [rel out_kind], 1
   143 000000D7 7526                        jne     .pipe
   144                                  
   145                                      ; ---- 真控制台：WriteConsoleW(h, s, len, &written, NULL) ----
   146 000000D9 488B0D(00000000)            mov     rcx, [rel h_out]
   147 000000E0 488B55F8                    mov     rdx, [rbp - 8]
   148 000000E4 448B45F0                    mov     r8d, dword [rbp - 16]
   149 000000E8 4C8D0D(10000000)            lea     r9, [rel written]
   150 000000EF 48C744242000000000          mov     qword [rsp + 32], 0     ; 第 5 参 lpReserved
   151 000000F8 E8(00000000)                call    WriteConsoleW
   152 000000FD EB65                        jmp     .done
   153                                  
   154                                  .pipe:
   155                                      ; ---- 管道：WideCharToMultiByte(CP_UTF8,0,s,len,buf,SIZE,NULL,NULL) ----
   156 000000FF B9E9FD0000                  mov     ecx, CP_UTF8
   157 00000104 31D2                        xor     edx, edx
   158 00000106 4C8B45F8                    mov     r8, [rbp - 8]
   159 0000010A 448B4DF0                    mov     r9d, dword [rbp - 16]
   160 0000010E 488D05(14000000)            lea     rax, [rel utf8_buf]
   161 00000115 4889442420                  mov     qword [rsp + 32], rax           ; lpMultiByteStr
   162 0000011A 48C744242800100000          mov     qword [rsp + 40], UTF8_BUF_SIZE ; cbMultiByte
   163 00000123 48C744243000000000          mov     qword [rsp + 48], 0             ; lpDefaultChar
   164 0000012C 48C744243800000000          mov     qword [rsp + 56], 0             ; lpUsedDefaultChar
   165 00000135 E8(00000000)                call    WideCharToMultiByte
   166 0000013A 85C0                        test    eax, eax
   167 0000013C 7426                        jz      .done                   ; 转换失败（演示程序静默放弃）
   168                                  
   169                                      ; WriteFile(h, utf8_buf, eax, &written, NULL)
   170 0000013E 488B0D(00000000)            mov     rcx, [rel h_out]
   171 00000145 488D15(14000000)            lea     rdx, [rel utf8_buf]
   172 0000014C 4189C0                      mov     r8d, eax
   173 0000014F 4C8D0D(10000000)            lea     r9, [rel written]
   174 00000156 48C744242000000000          mov     qword [rsp + 32], 0
   175 0000015F E8(00000000)                call    WriteFile
   176                                  
   177                                  .done:
   178 00000164 C9                          leave
   179 00000165 C3                          ret
   180                                  
   181                                  ; ------------------------------------------------------------
   182                                  ; util_alloc(SIZE_T rcx 字节数) -> rax = 指针（失败 NULL）
   183                                  ; 相当于 malloc；进程堆 = GetProcessHeap()
   184                                  ; ------------------------------------------------------------
   185                                  util_alloc:
   186 00000166 55                          push    rbp
   187 00000167 4889E5                      mov     rbp, rsp
   188 0000016A 4883EC20                    sub     rsp, FRAME_SUB_RSP
   189                                  
   190 0000016E 4989C8                      mov     r8, rcx                 ; 第 3 参 dwBytes
   191 00000171 E8(00000000)                call    GetProcessHeap
   192 00000176 4889C1                      mov     rcx, rax                ; 第 1 参 hHeap
   193 00000179 31D2                        xor     edx, edx                ; 第 2 参 dwFlags = 0
   194 0000017B E8(00000000)                call    HeapAlloc
   195 00000180 C9                          leave
   196 00000181 C3                          ret
   197                                  
   198                                  ; ------------------------------------------------------------
   199                                  ; util_free(LPVOID rcx)：释放 util_alloc 拿到的内存
   200                                  ; ------------------------------------------------------------
   201                                  util_free:
   202 00000182 55                          push    rbp
   203 00000183 4889E5                      mov     rbp, rsp
   204 00000186 4883EC20                    sub     rsp, FRAME_SUB_RSP
   205                                  
   206 0000018A 4989C8                      mov     r8, rcx                 ; 第 3 参 lpMem
   207 0000018D E8(00000000)                call    GetProcessHeap
   208 00000192 4889C1                      mov     rcx, rax
   209 00000195 31D2                        xor     edx, edx
   210 00000197 E8(00000000)                call    HeapFree
   211 0000019C C9                          leave
   212 0000019D C3                          ret
