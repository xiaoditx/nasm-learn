   115                              <1> ; WNDCLASSEXW：winuser.h:897-910。x64 下 sizeof == 80。
   116                              <1> ; 注意 cbClsExtra(16) 与 cbWndExtra(20) 之间没有填充，
   117                              <1> ; 但 hInstance 位于 24，正好是 8 字节对齐，所以这里不需要手工补位。
   118                              <1> struc WNDCLASSEXW
   119 00000000 ????????            <1>     .cbSize:        resd 1      ; +0
   120 00000004 ????????            <1>     .style:         resd 1      ; +4
   121 00000008 ????????????????    <1>     .lpfnWndProc:   resq 1      ; +8
   122 00000010 ????????            <1>     .cbClsExtra:    resd 1      ; +16
   123 00000014 ????????            <1>     .cbWndExtra:    resd 1      ; +20
   124 00000018 ????????????????    <1>     .hInstance:     resq 1      ; +24
   125 00000020 ????????????????    <1>     .hIcon:         resq 1      ; +32
   126 00000028 ????????????????    <1>     .hCursor:       resq 1      ; +40
   127 00000030 ????????????????    <1>     .hbrBackground: resq 1      ; +48
   128 00000038 ????????????????    <1>     .lpszMenuName:  resq 1      ; +56
   129 00000040 ????????????????    <1>     .lpszClassName: resq 1      ; +64
   130 00000048 ????????????????    <1>     .hIconSm:       resq 1      ; +72
   131                              <1> endstruc                        ; = 80
   132                              <1> 
   133                              <1> ; MSG：winuser.h:955-961。x64 下 sizeof == 48。
   134                              <1> ; message 之后有 4 字节隐式填充（wParam 必须 8 对齐），
   135                              <1> ; 末尾 pt 之后还有 4 字节尾部填充。NASM 的 struc 不会自动补，
   136                              <1> ; 所以显式写 .pad0 / .pad1。
   137                              <1> struc MSG
   138 00000000 ????????????????    <1>     .hwnd:      resq 1          ; +0
   139 00000008 ????????            <1>     .message:   resd 1          ; +8
   140 0000000C ????????            <1>     .pad0:      resd 1          ; +12  隐式填充
   141 00000010 ????????????????    <1>     .wParam:    resq 1          ; +16
   142 00000018 ????????????????    <1>     .lParam:    resq 1          ; +24
   143 00000020 ????????            <1>     .time:      resd 1          ; +32
   144 00000024 ????????            <1>     .pt_x:      resd 1          ; +36
   145 00000028 ????????            <1>     .pt_y:      resd 1          ; +40
   146 0000002C ????????            <1>     .pad1:      resd 1          ; +44  尾部填充
   147                              <1> endstruc                        ; = 48
   148                              <1> 
   149                              <1> ; PAINTSTRUCT：winuser.h:1823-1830。x64 下 sizeof == 72。
   150                              <1> struc PAINTSTRUCT
   151 00000000 ????????????????    <1>     .hdc:           resq 1      ; +0
   152 00000008 ????????            <1>     .fErase:        resd 1      ; +8
   153 0000000C ????????            <1>     .rcPaint_left:  resd 1      ; +12
   154 00000010 ????????            <1>     .rcPaint_top:   resd 1      ; +16
   155 00000014 ????????            <1>     .rcPaint_right: resd 1      ; +20
   156 00000018 ????????            <1>     .rcPaint_bottom:resd 1      ; +24
   157 0000001C ????????            <1>     .fRestore:      resd 1      ; +28
   158 00000020 ????????            <1>     .fIncUpdate:    resd 1      ; +32
   159 00000024 <res 20h>           <1>     .rgbReserved:   resb 32     ; +36
   160 00000044 ????????            <1>     .pad:           resb 4      ; +68  补齐到 8 的倍数
   161                              <1> endstruc                        ; = 72
   162                              <1> 
   163                              <1> ; RECT：windef.h，4 个 LONG，共 16 字节
   164                              <1> struc RECT
   165 00000000 ????????            <1>     .left:   resd 1
   166 00000004 ????????            <1>     .top:    resd 1
   167 00000008 ????????            <1>     .right:  resd 1
   168 0000000C ????????            <1>     .bottom: resd 1
   169                              <1> endstruc                        ; = 16
