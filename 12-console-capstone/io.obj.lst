    10                                  section .text
    11                                      global  io_write_file
    12                                      global  io_read_file
    13                                      extern  CreateFileW
    14                                      extern  WriteFile
    15                                      extern  ReadFile
    16                                      extern  CloseHandle
    17                                  
    18                                  ; ------------------------------------------------------------
    19                                  ; int io_write_file(wchar_t *path, void *buf, int bytes)
    20                                  ;   RCX = path, RDX = buf, R8D = bytes
    21                                  ; ------------------------------------------------------------
    22                                  io_write_file:
    23 00000000 55                          push    rbp
    24 00000001 4889E5                      mov     rbp, rsp
    25 00000004 4883EC60                    sub     rsp, 96                 ; 32 影子 + 3 个栈参数 + 本地槽
    26                                  
    27 00000008 48894DF8                    mov     qword [rbp - 8],  rcx   ; path
    28 0000000C 488955F0                    mov     qword [rbp - 16], rdx   ; buf
    29 00000010 448945E8                    mov     dword [rbp - 24], r8d   ; bytes
    30                                  
    31 00000014 BA00000040                  mov     edx, GENERIC_WRITE
    32 00000019 4531C0                      xor     r8d, r8d
    33 0000001C 4531C9                      xor     r9d, r9d
    34 0000001F 48C744242002000000          mov     qword [rsp + 32], CREATE_ALWAYS
    35 00000028 48C744242880000000          mov     qword [rsp + 40], FILE_ATTRIBUTE_NORMAL
    36 00000031 48C744243000000000          mov     qword [rsp + 48], NULL
    37 0000003A E8(00000000)                call    CreateFileW
    38 0000003F 4883F8FF                    cmp     rax, INVALID_HANDLE_VALUE
    39 00000043 7446                        je      .fail
    40                                  
    41 00000045 488945E0                    mov     qword [rbp - 32], rax   ; handle
    42                                  
    43 00000049 4889C1                      mov     rcx, rax
    44 0000004C 488B55F0                    mov     rdx, qword [rbp - 16]
    45 00000050 448B45E8                    mov     r8d, dword [rbp - 24]
    46 00000054 4C8D4DD8                    lea     r9, [rbp - 40]          ; &written
    47 00000058 48C744242000000000          mov     qword [rsp + 32], NULL
    48 00000061 E8(00000000)                call    WriteFile
    49 00000066 85C0                        test    eax, eax
    50 00000068 7418                        jz      .close_fail
    51                                  
    52 0000006A 8B45D8                      mov     eax, dword [rbp - 40]
    53 0000006D 3B45E8                      cmp     eax, dword [rbp - 24]
    54 00000070 7510                        jne     .close_fail
    55                                  
    56 00000072 488B4DE0                    mov     rcx, qword [rbp - 32]
    57 00000076 E8(00000000)                call    CloseHandle
    58 0000007B B801000000                  mov     eax, 1
    59 00000080 C9                          leave
    60 00000081 C3                          ret
    61                                  
    62                                  .close_fail:
    63 00000082 488B4DE0                    mov     rcx, qword [rbp - 32]
    64 00000086 E8(00000000)                call    CloseHandle
    65                                  .fail:
    66 0000008B 31C0                        xor     eax, eax
    67 0000008D C9                          leave
    68 0000008E C3                          ret
    69                                  
    70                                  ; ------------------------------------------------------------
    71                                  ; int io_read_file(wchar_t *path, void *buf, int cap)
    72                                  ;   RCX = path, RDX = buf, R8D = cap（字节）
    73                                  ; ------------------------------------------------------------
    74                                  io_read_file:
    75 0000008F 55                          push    rbp
    76 00000090 4889E5                      mov     rbp, rsp
    77 00000093 4883EC60                    sub     rsp, 96
    78                                  
    79 00000097 48894DF8                    mov     qword [rbp - 8],  rcx
    80 0000009B 488955F0                    mov     qword [rbp - 16], rdx
    81 0000009F 448945E8                    mov     dword [rbp - 24], r8d
    82                                  
    83 000000A3 BA00000080                  mov     edx, GENERIC_READ
    84 000000A8 4531C0                      xor     r8d, r8d
    85 000000AB 4531C9                      xor     r9d, r9d
    86 000000AE 48C744242003000000          mov     qword [rsp + 32], OPEN_EXISTING
    87 000000B7 48C744242880000000          mov     qword [rsp + 40], FILE_ATTRIBUTE_NORMAL
    88 000000C0 48C744243000000000          mov     qword [rsp + 48], NULL
    89 000000C9 E8(00000000)                call    CreateFileW
    90 000000CE 4883F8FF                    cmp     rax, INVALID_HANDLE_VALUE
    91 000000D2 7442                        je      .fail
    92                                  
    93 000000D4 488945E0                    mov     qword [rbp - 32], rax
    94                                  
    95 000000D8 4889C1                      mov     rcx, rax
