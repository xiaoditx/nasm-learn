    50 00000012 460069007200730074- <1>
    50 0000001B 00570069006E006400- <1>
    50 00000024 6F0077000000        <1>
    25                                  window_title: WSTRZ "x64 assembly - first window"
    25                              <1> window_title: 
    50 0000002A 780036003400200061- <1>  dw __utf16__(%1), 0
    50 00000033 007300730065006D00- <1>
    50 0000003C 62006C00790020002D- <1>
    50 00000045 002000660069007200- <1>
    50 0000004E 730074002000770069- <1>
