    32                                  section .text
    33                                  
    34                                  ; ------------------------------------------------------------
    35                                  ; WndProc(HWND rcx, UINT edx, WPARAM r8, LPARAM r9) -> LRESULT rax
    36                                  ; 入口 RSP%16==8；push rbp 后 0；sub rsp,32 后仍是 0（32 是 16 的倍数）
    37                                  ; ------------------------------------------------------------
    38                                  WndProc:
    39 00000000 55                          push    rbp
    40 00000001 4889E5                      mov     rbp, rsp
    41 00000004 4883EC20                    sub     rsp, FRAME_SUB_RSP      ; 32 字节影子空间
    42                                  
    43 00000008 83FA02                      cmp     edx, WM_DESTROY
    44 0000000B 7407                        je      .on_destroy
    45                                  
    46                                      ; 其余消息一律交给系统默认处理
    47 0000000D E8(00000000)                call    DefWindowProcW
    48 00000012 C9                          leave
    49 00000013 C3                          ret
    50                                  
    51                                  .on_destroy:
    52 00000014 31C9                        xor     ecx, ecx                ; PostQuitMessage(0)
    53 00000016 E8(00000000)                call    PostQuitMessage
    54 0000001B 31C0                        xor     eax, eax                ; WM_DESTROY 处理完返回 0
    55 0000001D C9                          leave
    56 0000001E C3                          ret
    57                                  
    58                                  ; ------------------------------------------------------------
    59                                  ; wmain：注册窗口类 → 创建窗口 → 显示 → 消息循环
    60                                  ; ------------------------------------------------------------
    61                                  wmain:
    62 0000001F 55                          push    rbp
    63 00000020 4889E5                      mov     rbp, rsp
    64 00000023 4881EC80000000              sub     rsp, 128                ; 32 影子 + 64 传出栈参 + 32 本地槽
    65                                  
    66 0000002A 48C745F800000000            mov     qword [rbp - 8], 0      ; [rbp-8] = hInstance
    67                                  
    68                                      ; hInstance = GetModuleHandleW(NULL)
    69 00000032 31C9                        xor     ecx, ecx
    70 00000034 E8(00000000)                call    GetModuleHandleW
    71 00000039 488945F8                    mov     [rbp - 8], rax
    72                                  
    73                                      ; ---- 把 wndclass 的 80 字节清零 ----
    74 0000003D 488D3D(00000000)            lea     rdi, [rel wndclass]
    75 00000044 31C0                        xor     eax, eax
    76 00000046 B914000000                  mov     ecx, WNDCLASSEXW_size / 4    ; 20 个 dword
    77 0000004B F3AB                        rep     stosd
    78                                  
    79                                      ; ---- 填 WNDCLASSEXW ----
    80 0000004D 488D05(00000000)            lea     rax, [rel wndclass]
    81 00000054 C70050000000                mov     dword [rax + WNDCLASSEXW.cbSize], WNDCLASSEXW_size
    82 0000005A C7400403000000              mov     dword [rax + WNDCLASSEXW.style], CS_HREDRAW | CS_VREDRAW
    83 00000061 488D0D98FFFFFF              lea     rcx, [rel WndProc]
    84 00000068 48894808                    mov     [rax + WNDCLASSEXW.lpfnWndProc], rcx
    85 0000006C 488B4DF8                    mov     rcx, [rbp - 8]
    86 00000070 48894818                    mov     [rax + WNDCLASSEXW.hInstance], rcx
