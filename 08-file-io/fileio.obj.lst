     1                                  ; ============================================================
     2                                  ; 第 08 章：文件 I/O —— CreateFileW / WriteFile / ReadFile / CloseHandle
     3                                  ; 流程：创建文件 → 写入 UTF-16 文本 → 关闭 → 重新打开 → 读回 → 打印
     4                                  ; 运行：.\fileio.exe
     5                                  ; ============================================================
     6                                  default rel
     7                                  %include "../common.asm"
     1                              <1> ; ============================================================
     2                              <1> ; common.asm —— 全项目共享定义
     3                              <1> ; 只包含预处理指令、常量与宏，不产生任何段/数据。
     4                              <1> ; 用法：在章节目录中写  %include "../common.asm"
     5                              <1> ; ============================================================
     6                              <1> 
     7                              <1> ; ---------- Windows x64 栈约定 ----------
     8                              <1> %define SHADOW_SPACE          32      ; 调用前必须预留的影子空间
     9                              <1> %define ENTRY_SUB_RSP         40      ; 入口 RSP%16==8 → 减 40 后 %16==0
    10                              <1> %define FRAME_SUB_RSP         32      ; push rbp 之后 %16==0 → 再减 32
    11                              <1> 
    12                              <1> ; ---------- 通用常量 ----------
    13                              <1> %define NULL                  0
    14                              <1> %define TRUE                  1
    15                              <1> %define FALSE                 0
    16                              <1> %define WCHAR_SIZE            2       ; UTF-16 码元大小
    17                              <1> %define MAX_PATH_W            260
    18                              <1> 
    19                              <1> ; ---------- 标准设备 ----------
    20                              <1> %define STD_OUTPUT_HANDLE     -11
    21                              <1> %define STD_ERROR_HANDLE      -12
    22                              <1> 
    23                              <1> ; ---------- 文件 ----------
    24                              <1> %define INVALID_HANDLE_VALUE  -1
    25                              <1> %define GENERIC_READ          0x80000000
    26                              <1> %define GENERIC_WRITE         0x40000000
    27                              <1> %define CREATE_ALWAYS         2
    28                              <1> %define OPEN_EXISTING         3
    29                              <1> %define FILE_ATTRIBUTE_NORMAL 0x80
    30                              <1> 
    31                              <1> ; ---------- 错误码 ----------
    32                              <1> %define ERROR_FILE_NOT_FOUND  2
    33                              <1> %define ERROR_PATH_NOT_FOUND  3
    34                              <1> %define ERROR_ACCESS_DENIED   5
    35                              <1> 
    36                              <1> ; ---------- 代码页 ----------
    37                              <1> %define CP_UTF8               65001
    38                              <1> 
    39                              <1> ; ---------- 堆 ----------
    40                              <1> %define HEAP_ZERO_MEMORY      8
    41                              <1> 
    42                              <1> ; ---------- 宽字符串宏（UTF-16LE） ----------
    43                              <1> ; WSTR  ：展开为 UTF-16LE 码元，不带结尾 0
    44                              <1> ; WSTRZ ：展开为 UTF-16LE 码元，并追加一个 0 结尾
    45                              <1> %macro WSTR 1
    46                              <1>     dw __utf16__(%1)
    47                              <1> %endmacro
    48                              <1> 
    49                              <1> %macro WSTRZ 1
    50                              <1>     dw __utf16__(%1), 0
    51                              <1> %endmacro
    52                              <1> 
    53                              <1> ; ---------- 第 12 章：文本统计结构（多个 .asm 共用） ----------
    54                              <1> struc TEXT_STATS
    55 00000000 ????????            <1>     .chars: resd 1
    56 00000004 ????????            <1>     .lines: resd 1
    57 00000008 ????????            <1>     .words: resd 1
    58                              <1> endstruc
     8                                  
     9                                  section .rdata
    10                                      filename:   WSTRZ "demo_file.txt"
    10                              <1>  filename: 
    50 00000000 640065006D006F005F- <1>  dw __utf16__(%1), 0
    50 00000009 00660069006C006500- <1>
    50 00000012 2E0074007800740000- <1>
    50 0000001B 00                  <1>
    11                                  
    12                                  ; 要写入文件的 UTF-16LE 文本（3 行）
    13                                      content:
    14                                          WSTR "line one"
    46 0000001C 6C0069006E00650020- <1>  dw __utf16__(%1)
    46 00000025 006F006E006500      <1>
    15 0000002C 0D000A00                        dw 13, 10
    16                                          WSTR "line two"
    46 00000030 6C0069006E00650020- <1>  dw __utf16__(%1)
    46 00000039 00740077006F00      <1>
    17 00000040 0D000A00                        dw 13, 10
    18                                          WSTR "line three"
    46 00000044 6C0069006E00650020- <1>  dw __utf16__(%1)
    46 0000004D 007400680072006500- <1>
    46 00000056 6500                <1>
    19 00000058 0D000A00                        dw 13, 10
    20                                      content_chars equ ($ - content) / WCHAR_SIZE
    21                                      content_bytes equ content_chars * WCHAR_SIZE
    22                                  
    23                                      msg_written:  WSTR "WriteFile  : %lu bytes"
    23                              <1>  msg_written: 
    46 0000005C 570072006900740065- <1>  dw __utf16__(%1)
    46 00000065 00460069006C006500- <1>
    46 0000006E 200020003A00200025- <1>
    46 00000077 006C00750020006200- <1>
    46 00000080 7900740065007300    <1>
    24 00000088 0A000000                                  dw 10, 0
    25                                      msg_read:     WSTR "ReadFile   : %lu bytes"
    25                              <1>  msg_read: 
    46 0000008C 520065006100640046- <1>  dw __utf16__(%1)
    46 00000095 0069006C0065002000- <1>
    46 0000009E 200020003A00200025- <1>
    46 000000A7 006C00750020006200- <1>
    46 000000B0 7900740065007300    <1>
    26 000000B8 0A000000                                  dw 10, 0
    27                                      msg_readback: WSTR "--- read back from disk ---"
    27                              <1>  msg_readback: 
    46 000000BC 2D002D002D00200072- <1>  dw __utf16__(%1)
    46 000000C5 006500610064002000- <1>
    46 000000CE 6200610063006B0020- <1>
    46 000000D7 00660072006F006D00- <1>
    46 000000E0 20006400690073006B- <1>
    46 000000E9 0020002D002D002D00  <1>
    28 000000F2 0A000000                                  dw 10, 0
    29                                      msg_content:  WSTR "%ls"
    29                              <1>  msg_content: 
    46 000000F6 25006C007300        <1>  dw __utf16__(%1)
    30 000000FC 0A000000                                  dw 10, 0
    31                                      msg_open_fail:  WSTR "CreateFileW failed, error=%lu"
    31                              <1>  msg_open_fail: 
    46 00000100 430072006500610074- <1>  dw __utf16__(%1)
    46 00000109 006500460069006C00- <1>
    46 00000112 650057002000660061- <1>
    46 0000011B 0069006C0065006400- <1>
    46 00000124 2C0020006500720072- <1>
    46 0000012D 006F0072003D002500- <1>
    46 00000136 6C007500            <1>
    32 0000013A 0A000000                                    dw 10, 0
    33                                      msg_write_fail: WSTR "WriteFile failed, error=%lu"
    33                              <1>  msg_write_fail: 
    46 0000013E 570072006900740065- <1>  dw __utf16__(%1)
    46 00000147 00460069006C006500- <1>
    46 00000150 20006600610069006C- <1>
    46 00000159 00650064002C002000- <1>
    46 00000162 6500720072006F0072- <1>
    46 0000016B 003D0025006C007500  <1>
    34 00000174 0A000000                                    dw 10, 0
    35                                      msg_read_fail:  WSTR "ReadFile failed, error=%lu"
    35                              <1>  msg_read_fail: 
    46 00000178 520065006100640046- <1>  dw __utf16__(%1)
    46 00000181 0069006C0065002000- <1>
    46 0000018A 6600610069006C0065- <1>
    46 00000193 0064002C0020006500- <1>
    46 0000019C 720072006F0072003D- <1>
    46 000001A5 0025006C007500      <1>
    36 000001AC 0A000000                                    dw 10, 0
    37                                  
    38                                  section .bss
    39 00000000 <res 200h>                  read_buf:   resb 512            ; 256 个 UTF-16 码元
    40                                  
    41                                  section .text
    42                                      global  wmain
    43                                      extern  wprintf
    44                                      extern  CreateFileW
    45                                      extern  WriteFile
    46                                      extern  ReadFile
    47                                      extern  CloseHandle
    48                                      extern  GetLastError
    49                                  
    50                                  ; int wmain(int argc, wchar_t **argv)
    51                                  wmain:
    52 00000000 55                          push    rbp
    53 00000001 4889E5                      mov     rbp, rsp
    54 00000004 4881EC80000000              sub     rsp, 128                ; 32 影子 + 3 个栈参数 + 本地槽
    55                                  
    56                                  ; ---------- 1. 创建/覆盖文件 ----------
    57 0000000B 488D0D(00000000)            lea     rcx, [rel filename]
    58 00000012 BA000000C0                  mov     edx, GENERIC_READ | GENERIC_WRITE
    59 00000017 4531C0                      xor     r8d, r8d                ; dwShareMode = 0
    60 0000001A 4531C9                      xor     r9d, r9d                ; lpSecurityAttributes = NULL
    61 0000001D 48C744242002000000          mov     qword [rsp + 32], CREATE_ALWAYS
    62 00000026 48C744242880000000          mov     qword [rsp + 40], FILE_ATTRIBUTE_NORMAL
    63 0000002F 48C744243000000000          mov     qword [rsp + 48], NULL  ; hTemplateFile
    64 00000038 E8(00000000)                call    CreateFileW
    65 0000003D 488945F8                    mov     qword [rbp - 8], rax
    66 00000041 4883F8FF                    cmp     rax, INVALID_HANDLE_VALUE
    67 00000045 0F84ED000000                je      .fail_open
    68                                  
    69                                  ; ---------- 2. 写入 UTF-16 文本 ----------
    70 0000004B 488B4DF8                    mov     rcx, qword [rbp - 8]
    71 0000004F 488D15(1C000000)            lea     rdx, [rel content]
    72 00000056 41B840000000                mov     r8d, content_bytes
    73 0000005C 4C8D4DF0                    lea     r9, [rbp - 16]          ; &bytesWritten
    74 00000060 48C744242000000000          mov     qword [rsp + 32], NULL  ; lpOverlapped
    75 00000069 E8(00000000)                call    WriteFile
    76 0000006E 85C0                        test    eax, eax
    77 00000070 0F84E2000000                jz      .fail_write
    78                                  
    79 00000076 488D0D(5C000000)            lea     rcx, [rel msg_written]
    80 0000007D 8B55F0                      mov     edx, dword [rbp - 16]
    81 00000080 31C0                        xor     eax, eax
    82 00000082 E8(00000000)                call    wprintf
    83                                  
    84                                  ; ---------- 3. 关闭 ----------
    85 00000087 488B4DF8                    mov     rcx, qword [rbp - 8]
    86 0000008B E8(00000000)                call    CloseHandle
    87                                  
    88                                  ; ---------- 4. 重新以只读方式打开 ----------
    89 00000090 488D0D(00000000)            lea     rcx, [rel filename]
    90 00000097 BA00000080                  mov     edx, GENERIC_READ
    91 0000009C 4531C0                      xor     r8d, r8d
    92 0000009F 4531C9                      xor     r9d, r9d
    93 000000A2 48C744242003000000          mov     qword [rsp + 32], OPEN_EXISTING
    94 000000AB 48C744242880000000          mov     qword [rsp + 40], FILE_ATTRIBUTE_NORMAL
    95 000000B4 48C744243000000000          mov     qword [rsp + 48], NULL
    96 000000BD E8(00000000)                call    CreateFileW
    97 000000C2 488945F8                    mov     qword [rbp - 8], rax
    98 000000C6 4883F8FF                    cmp     rax, INVALID_HANDLE_VALUE
    99 000000CA 746C                        je      .fail_open
   100                                  
   101                                  ; ---------- 5. 读回 ----------
   102 000000CC 488B4DF8                    mov     rcx, qword [rbp - 8]
   103 000000D0 488D15(00000000)            lea     rdx, [rel read_buf]
   104 000000D7 41B800020000                mov     r8d, 512                ; 缓冲区容量（字节）
   105 000000DD 4C8D4DE8                    lea     r9, [rbp - 24]          ; &bytesRead
   106 000000E1 48C744242000000000          mov     qword [rsp + 32], NULL
   107 000000EA E8(00000000)                call    ReadFile
   108 000000EF 85C0                        test    eax, eax
   109 000000F1 0F848A000000                jz      .fail_read
   110                                  
   111 000000F7 488B4DF8                    mov     rcx, qword [rbp - 8]
   112 000000FB E8(00000000)                call    CloseHandle
   113                                  
   114                                  ; ---------- 6. 打印读回结果 ----------
   115 00000100 488D0D(8C000000)            lea     rcx, [rel msg_read]
   116 00000107 8B55E8                      mov     edx, dword [rbp - 24]
   117 0000010A 31C0                        xor     eax, eax
   118 0000010C E8(00000000)                call    wprintf
   119                                  
   120 00000111 488D0D(BC000000)            lea     rcx, [rel msg_readback]
   121 00000118 31C0                        xor     eax, eax
   122 0000011A E8(00000000)                call    wprintf
   123                                  
   124 0000011F 488D0D(F6000000)            lea     rcx, [rel msg_content]
   125 00000126 488D15(00000000)            lea     rdx, [rel read_buf]
   126 0000012D 31C0                        xor     eax, eax
   127 0000012F E8(00000000)                call    wprintf
   128                                  
   129 00000134 31C0                        xor     eax, eax
   130 00000136 C9                          leave
   131 00000137 C3                          ret
   132                                  
   133                                  ; ---------- 失败路径 ----------
   134                                  .fail_open:
   135 00000138 E8(00000000)                call    GetLastError
   136 0000013D 8945E4                      mov     dword [rbp - 28], eax
   137 00000140 488D0D(00010000)            lea     rcx, [rel msg_open_fail]
   138 00000147 8B55E4                      mov     edx, dword [rbp - 28]
   139 0000014A 31C0                        xor     eax, eax
   140 0000014C E8(00000000)                call    wprintf
   141 00000151 B801000000                  mov     eax, 1
   142 00000156 C9                          leave
   143 00000157 C3                          ret
   144                                  
   145                                  .fail_write:
   146 00000158 E8(00000000)                call    GetLastError
   147 0000015D 8945E4                      mov     dword [rbp - 28], eax
   148 00000160 488B4DF8                    mov     rcx, qword [rbp - 8]
   149 00000164 E8(00000000)                call    CloseHandle
   150 00000169 488D0D(3E010000)            lea     rcx, [rel msg_write_fail]
   151 00000170 8B55E4                      mov     edx, dword [rbp - 28]
   152 00000173 31C0                        xor     eax, eax
   153 00000175 E8(00000000)                call    wprintf
   154 0000017A B802000000                  mov     eax, 2
   155 0000017F C9                          leave
   156 00000180 C3                          ret
   157                                  
   158                                  .fail_read:
   159 00000181 E8(00000000)                call    GetLastError
   160 00000186 8945E4                      mov     dword [rbp - 28], eax
   161 00000189 488B4DF8                    mov     rcx, qword [rbp - 8]
   162 0000018D E8(00000000)                call    CloseHandle
   163 00000192 488D0D(78010000)            lea     rcx, [rel msg_read_fail]
   164 00000199 8B55E4                      mov     edx, dword [rbp - 28]
   165 0000019C 31C0                        xor     eax, eax
   166 0000019E E8(00000000)                call    wprintf
   167 000001A3 B803000000                  mov     eax, 3
   168 000001A8 C9                          leave
   169 000001A9 C3                          ret
