     1                                  ; ============================================================
     2                                  ; 第 01 章：寄存器全景
     3                                  ;
     4                                  ; 构建（在本目录下执行）：
     5                                  ;   nasm -f win64 -l registers.lst -o registers.obj registers.asm
     6                                  ;   ld -o registers.exe registers.obj -L "C:/msys64/ucrt64/lib" -lkernel32 --subsystem console --entry=_start
     7                                  ;
     8                                  ; 运行后退出码应为 63（6 项检查全部通过，位掩码 0x3F）：
     9                                  ;   .\registers.exe
    10                                  ;   $LASTEXITCODE
    11                                  ; ============================================================
    12                                  
    13                                  default rel
    14                                  
    15                                  section .text
    16                                      global _start
    17                                      extern ExitProcess
    18                                  
    19                                  _start:
    20                                      ; Windows x64 入口：RSP % 16 == 8。
    21                                      ; sub rsp, 40 = 8 字节对齐 + 32 字节影子空间。
    22 00000000 4883EC28                    sub rsp, 40
    23                                  
    24 00000004 4531FF                      xor r15d, r15d              ; R15D 作为 6 项检查的位掩码
    25                                  
    26                                      ; ---- 检查 1：写 32 位寄存器会清零高 32 位 ----
    27 00000007 48C7C0FFFFFFFF              mov rax, 0xFFFFFFFFFFFFFFFF
    28 0000000E B878563412                  mov eax, 0x12345678         ; 高 32 位自动清零
    29 00000013 483D78563412                cmp rax, 0x12345678
    30 00000019 7504                        jne .c1
    31 0000001B 4183CF01                    or r15d, 1
    32                                  .c1:
    33                                  
    34                                      ; ---- 检查 2：8 位子寄存器只改最低字节 ----
    35 0000001F 48B888776655443322-         mov rax, 0x1122334455667788
    35 00000028 11                 
    36 00000029 B099                        mov al, 0x99                ; 只改 AL
    37 0000002B 48BB99776655443322-         mov rbx, 0x1122334455667799
    37 00000034 11                 
    38 00000035 4839D8                      cmp rax, rbx
    39 00000038 7504                        jne .c2
    40 0000003A 4183CF02                    or r15d, 2
    41                                  .c2:
    42                                  
    43                                      ; ---- 检查 3：movzx 零扩展 ----
    44 0000003E B080                        mov al, 0x80
    45 00000040 0FB6C8                      movzx ecx, al               ; 0x80，而不是 0xFFFFFF80
    46 00000043 81F980000000                cmp ecx, 0x80
    47 00000049 7504                        jne .c3
    48 0000004B 4183CF04                    or r15d, 4
    49                                  .c3:
    50                                  
    51                                      ; ---- 检查 4：movsx 符号扩展 ----
    52 0000004F B080                        mov al, 0x80
    53 00000051 0FBED0                      movsx edx, al               ; 0xFFFFFF80 == -128
    54 00000054 83FA80                      cmp edx, 0xFFFFFF80
    55 00000057 7504                        jne .c4
    56 00000059 4183CF08                    or r15d, 8
    57                                  .c4:
    58                                  
    59                                      ; ---- 检查 5：xchg 交换两个寄存器 ----
    60 0000005D B811111111                  mov eax, 0x11111111
    61 00000062 BB22222222                  mov ebx, 0x22222222
    62 00000067 93                          xchg eax, ebx
    63 00000068 3D22222222                  cmp eax, 0x22222222
    64 0000006D 7504                        jne .c5
    65 0000006F 4183CF10                    or r15d, 16
    66                                  .c5:
    67                                  
    68                                      ; ---- 检查 6：R8 / R8D / R8W / R8B 命名 ----
    69 00000073 49B888776655443322-         mov r8, 0x1122334455667788
    69 0000007C 11                 
    70 0000007D 41B8CCBBAA99                mov r8d, 0x99AABBCC         ; 高 32 位被清零
    71 00000083 41B9CCBBAA99                mov r9, 0x0000000099AABBCC
    72 00000089 4D39C8                      cmp r8, r9
    73 0000008C 7504                        jne .c6
    74 0000008E 4183CF20                    or r15d, 32
    75                                  .c6:
    76                                  
    77                                      ; 退出码 = 位掩码。全部通过时 1|2|4|8|16|32 = 63。
    78 00000092 4489F9                      mov ecx, r15d
    79 00000095 E8(00000000)                call ExitProcess            ; 不返回
