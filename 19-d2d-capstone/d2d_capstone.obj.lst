   110                              <1> ; WNDCLASSEXW：winuser.h:897-910。x64 下 sizeof == 80。
   111                              <1> ; 注意 cbClsExtra(16) 与 cbWndExtra(20) 之间没有填充，
   112                              <1> ; 但 hInstance 位于 24，正好是 8 字节对齐，所以这里不需要手工补位。
   113                              <1> struc WNDCLASSEXW
   114 00000000 ????????            <1>     .cbSize:        resd 1      ; +0
   115 00000004 ????????            <1>     .style:         resd 1      ; +4
   116 00000008 ????????????????    <1>     .lpfnWndProc:   resq 1      ; +8
   117 00000010 ????????            <1>     .cbClsExtra:    resd 1      ; +16
   118 00000014 ????????            <1>     .cbWndExtra:    resd 1      ; +20
   119 00000018 ????????????????    <1>     .hInstance:     resq 1      ; +24
   120 00000020 ????????????????    <1>     .hIcon:         resq 1      ; +32
   121 00000028 ????????????????    <1>     .hCursor:       resq 1      ; +40
   122 00000030 ????????????????    <1>     .hbrBackground: resq 1      ; +48
   123 00000038 ????????????????    <1>     .lpszMenuName:  resq 1      ; +56
   124 00000040 ????????????????    <1>     .lpszClassName: resq 1      ; +64
   125 00000048 ????????????????    <1>     .hIconSm:       resq 1      ; +72
   126                              <1> endstruc                        ; = 80
   127                              <1> 
   128                              <1> ; MSG：winuser.h:955-961。x64 下 sizeof == 48。
   129                              <1> ; message 之后有 4 字节隐式填充（wParam 必须 8 对齐），
   130                              <1> ; 末尾 pt 之后还有 4 字节尾部填充。NASM 的 struc 不会自动补，
   131                              <1> ; 所以显式写 .pad0 / .pad1。
   132                              <1> struc MSG
   133 00000000 ????????????????    <1>     .hwnd:      resq 1          ; +0
   134 00000008 ????????            <1>     .message:   resd 1          ; +8
   135 0000000C ????????            <1>     .pad0:      resd 1          ; +12  隐式填充
   136 00000010 ????????????????    <1>     .wParam:    resq 1          ; +16
   137 00000018 ????????????????    <1>     .lParam:    resq 1          ; +24
   138 00000020 ????????            <1>     .time:      resd 1          ; +32
   139 00000024 ????????            <1>     .pt_x:      resd 1          ; +36
   140 00000028 ????????            <1>     .pt_y:      resd 1          ; +40
   141 0000002C ????????            <1>     .pad1:      resd 1          ; +44  尾部填充
   142                              <1> endstruc                        ; = 48
   143                              <1> 
   144                              <1> ; PAINTSTRUCT：winuser.h:1823-1830。x64 下 sizeof == 72。
   145                              <1> struc PAINTSTRUCT
   146 00000000 ????????????????    <1>     .hdc:           resq 1      ; +0
   147 00000008 ????????            <1>     .fErase:        resd 1      ; +8
   148 0000000C ????????            <1>     .rcPaint_left:  resd 1      ; +12
   149 00000010 ????????            <1>     .rcPaint_top:   resd 1      ; +16
   150 00000014 ????????            <1>     .rcPaint_right: resd 1      ; +20
   151 00000018 ????????            <1>     .rcPaint_bottom:resd 1      ; +24
   152 0000001C ????????            <1>     .fRestore:      resd 1      ; +28
   153 00000020 ????????            <1>     .fIncUpdate:    resd 1      ; +32
   154 00000024 <res 20h>           <1>     .rgbReserved:   resb 32     ; +36
   155 00000044 ????????            <1>     .pad:           resb 4      ; +68  补齐到 8 的倍数
   156                              <1> endstruc                        ; = 72
   157                              <1> 
   158                              <1> ; RECT：windef.h，4 个 LONG，共 16 字节
   159                              <1> struc RECT
   160 00000000 ????????            <1>     .left:   resd 1
   161 00000004 ????????            <1>     .top:    resd 1
   162 00000008 ????????            <1>     .right:  resd 1
   163 0000000C ????????            <1>     .bottom: resd 1
   164                              <1> endstruc                        ; = 16
