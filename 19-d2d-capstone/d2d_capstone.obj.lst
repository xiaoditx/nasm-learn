    86                                  ; release_scene：释放画刷与渲染目标（不释放工厂）
    87                                  ; ------------------------------------------------------------
    88                                  release_scene:
    89 00000000 55                          push    rbp
    90 00000001 4889E5                      mov     rbp, rsp
