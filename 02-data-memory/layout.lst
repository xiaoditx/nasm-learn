     1                                  ; ============================================================
     2                                  ; 第 02 章：数据定义与内存布局
     3                                  ;
     4                                  ; 构建（在本目录下执行）：
     5                                  ;   nasm -f win64 -l layout.lst -o layout.obj layout.asm
     6                                  ;   ld -o layout.exe layout.obj -L "C:/msys64/ucrt64/lib" -lkernel32 --subsystem console --entry=_start
     7                                  ;
     8                                  ; 运行后退出码为校验和（见 README 的逐项计算，应为 220）：
     9                                  ;   .\layout.exe
    10                                  ;   $LASTEXITCODE
    11                                  ; ============================================================
    12                                  
    13                                  default rel
    14                                  
    15                                  section .data
    16 00000000 56                          val8      db  0x56                  ; 1 字节
    17 00000001 3412                        val16     dw  0x1234                ; 2 字节
    18 00000003 EFBEADDE                    val32     dd  0xDEADBEEF            ; 4 字节
    19 00000007 90                          align 8
    20 00000008 8877665544332211            val64     dq  0x1122334455667788    ; 8 字节
    21 00000010 4E41534D00                  msg       db  'NASM', 0             ; 5 字节：4 个字符 + 结束符
    22                                      MSG_LEN   equ 4                     ; equ 不占空间，编译期常量
    23 00000015 AA<rep 3h>                  times 3   db  0xAA                  ; 填充 3 字节，验证 times
    24                                  
    25                                  section .bss
    26 00000000 ??                          bss8      resb 1                    ; 保留 1 字节
    27 00000001 ????                        bss16     resw 1                    ; 保留 1 字（2 字节）
    28 00000003 ????????                    bss32     resd 1                    ; 保留 1 双字（4 字节）
    29 00000007 ????????????????            bss64     resq 1                    ; 保留 1 四字（8 字节）
    30                                  
    31                                  section .text
    32                                      global _start
    33                                      extern ExitProcess
    34                                  
    35                                  _start:
    36 00000000 4883EC28                    sub rsp, 40
    37                                  
    38                                      ; ---- 按各自宽度读取，累加成校验和 ----
    39 00000004 0FB605(00000000)            movzx eax, byte [rel val8]      ; 0x56
    40 0000000B 0FB70D(01000000)            movzx ecx, word [rel val16]     ; 0x1234
    41 00000012 01C8                        add eax, ecx                    ; 0x128A
    42                                  
    43 00000014 8B0D(03000000)              mov ecx, [rel val32]            ; 0xDEADBEEF
    44 0000001A 31C8                        xor eax, ecx                    ; 0xDEADAC65
    45                                  
    46 0000001C 3305(08000000)              xor eax, [rel val64]            ; 低 32 位 0x55667788
    47                                                                      ; 0x8BCBDBED
    48                                  
    49 00000022 0FB60D(03000000)            movzx ecx, byte [rel val32]     ; 小端：最低字节是 0xEF
    50 00000029 01C8                        add eax, ecx                    ; 0x8BCBDCDC
    51                                  
    52 0000002B 8B0D(03000000)              mov ecx, [rel bss32]            ; .bss 加载时清零
    53 00000031 01C8                        add eax, ecx                    ; 不变
    54                                  
    55 00000033 25FF000000                  and eax, 0xFF                   ; 只留低 8 位 → 0xDC
    56 00000038 89C1                        mov ecx, eax
    57 0000003A E8(00000000)                call ExitProcess                ; 退出码 220
