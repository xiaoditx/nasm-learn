     1                                  ; ============================================================
     2                                  ; 第 07 章：wmain 的 argc / argv（宽字符参数表）
     3                                  ; 运行：.\args.exe alpha beta "two words"
     4                                  ; 说明：argv 是 wchar_t* 数组，每个元素指向一个 UTF-16 字符串。
     5                                  ; ============================================================
     6                                  default rel
     7                                  %include "../common.asm"
     1                              <1> ; ============================================================
     2                              <1> ; common.asm —— 全项目共享定义
     3                              <1> ; 只包含预处理指令、常量与宏，不产生任何段/数据。
     4                              <1> ; 用法：在章节目录中写  %include "../common.asm"
     5                              <1> ; ============================================================
     6                              <1> 
     7                              <1> ; ---------- Windows x64 栈约定 ----------
     8                              <1> %define SHADOW_SPACE          32      ; 调用前必须预留的影子空间
     9                              <1> %define ENTRY_SUB_RSP         40      ; 入口 RSP%16==8 → 减 40 后 %16==0
    10                              <1> %define FRAME_SUB_RSP         32      ; push rbp 之后 %16==0 → 再减 32
    11                              <1> 
    12                              <1> ; ---------- 通用常量 ----------
    13                              <1> %define NULL                  0
    14                              <1> %define TRUE                  1
    15                              <1> %define FALSE                 0
    16                              <1> %define WCHAR_SIZE            2       ; UTF-16 码元大小
    17                              <1> %define MAX_PATH_W            260
    18                              <1> 
    19                              <1> ; ---------- 标准设备 ----------
    20                              <1> %define STD_OUTPUT_HANDLE     -11
    21                              <1> %define STD_ERROR_HANDLE      -12
    22                              <1> 
    23                              <1> ; ---------- 文件 ----------
    24                              <1> %define INVALID_HANDLE_VALUE  -1
    25                              <1> %define GENERIC_READ          0x80000000
    26                              <1> %define GENERIC_WRITE         0x40000000
    27                              <1> %define CREATE_ALWAYS         2
    28                              <1> %define OPEN_EXISTING         3
    29                              <1> %define FILE_ATTRIBUTE_NORMAL 0x80
    30                              <1> 
    31                              <1> ; ---------- 错误码 ----------
    32                              <1> %define ERROR_FILE_NOT_FOUND  2
    33                              <1> %define ERROR_PATH_NOT_FOUND  3
    34                              <1> %define ERROR_ACCESS_DENIED   5
    35                              <1> 
    36                              <1> ; ---------- 代码页 ----------
    37                              <1> %define CP_UTF8               65001
    38                              <1> 
    39                              <1> ; ---------- 堆 ----------
    40                              <1> %define HEAP_ZERO_MEMORY      8
    41                              <1> 
    42                              <1> ; ---------- 宽字符串宏（UTF-16LE） ----------
    43                              <1> ; WSTR  ：展开为 UTF-16LE 码元，不带结尾 0
    44                              <1> ; WSTRZ ：展开为 UTF-16LE 码元，并追加一个 0 结尾
    45                              <1> %macro WSTR 1
    46                              <1>     dw __utf16__(%1)
    47                              <1> %endmacro
    48                              <1> 
    49                              <1> %macro WSTRZ 1
    50                              <1>     dw __utf16__(%1), 0
    51                              <1> %endmacro
    52                              <1> 
    53                              <1> ; ---------- 第 12 章：文本统计结构（多个 .asm 共用） ----------
    54                              <1> struc TEXT_STATS
    55 00000000 ????????            <1>     .chars: resd 1
    56 00000004 ????????            <1>     .lines: resd 1
    57 00000008 ????????            <1>     .words: resd 1
    58                              <1> endstruc
     8                                  
     9                                  section .rdata
    10                                      fmt_argc:   WSTR "argc = %d"
    10                              <1>  fmt_argc: 
    46 00000000 610072006700630020- <1>  dw __utf16__(%1)
    46 00000009 003D00200025006400  <1>
    11 00000012 0A000000                                dw 10, 0
    12                                      fmt_argv:   WSTR "argv[%d] @ %p = %ls"
    12                              <1>  fmt_argv: 
    46 00000016 61007200670076005B- <1>  dw __utf16__(%1)
    46 0000001F 00250064005D002000- <1>
    46 00000028 400020002500700020- <1>
    46 00000031 003D00200025006C00- <1>
    46 0000003A 7300                <1>
    13 0000003C 0A000000                                dw 10, 0
    14                                  
    15                                  section .text
    16                                      global  wmain
    17                                      extern  wprintf
    18                                  
    19                                  ; int wmain(int argc, wchar_t **argv)
    20                                  wmain:
    21 00000000 55                          push    rbp
    22 00000001 4889E5                      mov     rbp, rsp
    23 00000004 4883EC40                    sub     rsp, 64                 ; 32 影子空间 + 32 字节本地槽
    24                                  
    25 00000008 894DFC                      mov     dword [rbp - 4], ecx    ; argc
    26 0000000B 488955F0                    mov     qword [rbp - 16], rdx   ; argv
    27 0000000F C745EC00000000              mov     dword [rbp - 20], 0     ; i
    28                                  
    29 00000016 488D0D(00000000)            lea     rcx, [rel fmt_argc]
    30 0000001D 8B55FC                      mov     edx, dword [rbp - 4]
    31 00000020 31C0                        xor     eax, eax
    32 00000022 E8(00000000)                call    wprintf
    33                                  
    34                                  .loop:
    35 00000027 8B45EC                      mov     eax, dword [rbp - 20]   ; i
    36 0000002A 3B45FC                      cmp     eax, dword [rbp - 4]    ; i >= argc ?
    37 0000002D 7D20                        jge     .done
    38                                  
    39 0000002F 4C8B45F0                    mov     r8, qword [rbp - 16]    ; r8 = argv
    40 00000033 4D8B04C0                    mov     r8, qword [r8 + rax*8]  ; r8 = argv[i]
    41 00000037 4D89C1                      mov     r9, r8                  ; r9 = argv[i]（作为 %ls 的字符串）
    42                                  
    43 0000003A 89C2                        mov     edx, eax                ; %d = i
    44 0000003C 488D0D(16000000)            lea     rcx, [rel fmt_argv]
    45 00000043 31C0                        xor     eax, eax
    46 00000045 E8(00000000)                call    wprintf
    47                                  
    48 0000004A FF45EC                      inc     dword [rbp - 20]
    49 0000004D EBD8                        jmp     .loop
    50                                  
    51                                  .done:
    52 0000004F 31C0                        xor     eax, eax                ; 退出码 0
    53 00000051 C9                          leave
    54 00000052 C3                          ret
